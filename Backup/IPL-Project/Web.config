<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="IPLDb" connectionString="Data Source=.;Initial Catalog=ipl_ticket_booking;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fileEncoding="utf-8" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" />
    <hostingEnvironment shadowCopyBinAssemblies="false" />
  </system.web>
</configuration>